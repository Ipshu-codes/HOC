{
  "name": "ward16-heritage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check-content",
    "build": "next build",
    "postbuild": "tsx scripts/verify-output.ts",
    "build:preview": "tsx scripts/check-content.ts --allow-drafts && next build && tsx scripts/verify-output.ts",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check-content": "tsx scripts/check-content.ts",
    "optimize-images": "tsx scripts/optimize-images.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "image-size": "^2.1.0",
    "maplibre-gl": "5.24.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yet-another-react-lightbox": "3.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "heic-convert": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
