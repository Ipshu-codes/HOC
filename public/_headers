# Cloudflare Pages response headers (static export: there is no server to set them).

# Next.js build files have a content hash in their names: safe to cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and logos keep the same names when replaced: cache for a week, then revalidate.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Basic security headers for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
